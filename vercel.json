    { "source": "/index.html",     "destination": "/",              "permanent": true },
    { "source": "/streaming.html", "destination": "/streaming",     "permanent": true },
    { "source": "/gaming.html",    "destination": "/recargas",      "permanent": true },
    { "source": "/multi.html",     "destination": "/multiservicios","permanent": true }
  ]
}
