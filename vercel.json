{
  "rewrites": [
    { "source": "/streaming",     "destination": "/streaming.html" },
    { "source": "/recargas",      "destination": "/gaming.html" },
    { "source": "/multiservicios","destination": "/multi.html" }
  ],
  "redirects": [
    { "source": "/index.html",     "destination": "/",              "permanent": true },
    { "source": "/streaming.html", "destination": "/streaming",     "permanent": true },
    { "source": "/gaming.html",    "destination": "/recargas",      "permanent": true },
    { "source": "/multi.html",     "destination": "/multiservicios","permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
